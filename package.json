{
  "name": "@fingerprint-framework/core",
  "version": "0.1.0",
  "description": "Consent-aware browser signal and device intelligence framework with ESM and script-tag builds.",
  "type": "module",
  "license": "MIT",
  "main": "./dist/index.mjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./browser": "./dist/browser/fingerprint-framework.js",
    "./browser.min": "./dist/browser/fingerprint-framework.min.js",
    "./package.json": "./package.json"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "README.md"
  ],
  "scripts": {
    "clean": "node scripts/clean.mjs",
    "build": "node scripts/build.mjs",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run build && npm test"
  },
  "keywords": [
    "fingerprint",
    "browser",
    "device-intelligence",
    "signals",
    "privacy"
  ],
  "engines": {
    "node": ">=18"
  }
}
